  "defaultAssumptions": {
    "basis": "以下为可视化数量模型，不是特定厂商BOM",
    "opticalTopology": "parallel_single_mode",
    "signalFiberWavelengths": 1,
    "driverChannelsPerPackage": 4,
    "tiaChannelsPerPackage": 4,
    "picDuplexLanesPerDie": 8,
    "signalFauFibersPerAssembly": 8,
    "separateTxRxFau": true,
    "txLanesPerCwPath": 4,
    "cwPathsPerElsModule": 8,
    "elsAllocation": "share_by_active_optical_power_paths",
    "isolatorsPerCwPath": 1,
    "faradayRotatorsPerSingleStageIsolator": 1,
    "polarizerElementsPerSingleStageIsolator": 2,
    "stagesPerIsolator": 1,
    "sourceIds": [
      "AR02",
      "AR05",
      "AR06",
      "AR11"
    ],
    "limitation": "4lane/EIC和8lane/PIC是便于比较的集成假设。供光与隔离器数量必须结合功率预算、激光冗余及具体隔离器设计复核"
  },
  "quantityRules": [
    {
      "id": "q-optical",
      "quantity": "opticalTxLanes=opticalRxLanes",
      "formula": "capacityGbps / opticalLaneGbps",
      "kind": "functional_channel",
      "sourceIds": [
        "AR02"
      ],
      "note": "Tx和Rx均为该值，不将两方向相加成名义速率"
    },
    {
      "id": "q-electrical",
      "quantity": "electricalTxLanes=electricalRxLanes",
      "formula": "capacityGbps / electricalLaneGbps",
      "kind": "functional_channel",
      "sourceIds": [
        "AR02",
        "AR07"
      ],
      "note": "若光电lane速率不同，必须显式包含lane映射机制"
    },
    {
      "id": "q-driver",
      "quantity": "driverPackages",
      "formula": "ceil(opticalTxLanes / driverChannelsPerPackage)",
      "kind": "physical_assembly",
      "sourceIds": [
        "AR06"
      ],
      "note": "默认每颗4lane，可选8或16lane；均为等效集成假设，未知真实封装关系时不视为已核实器件颗数"
    },
    {
      "id": "q-tia",
      "quantity": "tiaPackages",
      "formula": "ceil(opticalRxLanes / tiaChannelsPerPackage)",
      "kind": "physical_assembly",
      "sourceIds": [
        "AR06"
      ],
      "note": "默认每颗4lane，可选8或16lane；均为等效集成假设，未知真实封装关系时不视为已核实器件颗数"
    },
    {
      "id": "q-pic",
      "quantity": "picDies",
      "formula": "ceil(max(opticalTxLanes,opticalRxLanes) / picDuplexLanesPerDie)",
      "kind": "physical_assembly",
      "sourceIds": [
        "AR05"
      ],
      "note": "8收发lane/裸片仅建模假设，不能冒充Marvell/Ciena裸片数量"
    },
    {
      "id": "q-modulator",
      "quantity": "modulatorChannels",
      "formula": "opticalTxLanes",
      "kind": "integrated_feature",
      "sourceIds": [
        "AR02",
        "AR05"
      ],
      "note": "包含于PIC价值，不另加完整采购成本；MZM与MRM是替代项"
    },
    {
      "id": "q-pd",
      "quantity": "photodetectorChannels",
      "formula": "opticalRxLanes",
      "kind": "integrated_feature",
      "sourceIds": [
        "AR02",
        "AR05"
      ],
      "note": "包含于PIC；不同PD阵列可为独立裸片，需具体设计覆盖"
    },
    {
      "id": "q-fiber",
      "quantity": "signalFibers",
      "formula": "ceil(opticalTxLanes / wavelengthsPerSignalFiber) + ceil(opticalRxLanes / wavelengthsPerSignalFiber)",
      "kind": "physical_assembly",
      "sourceIds": [
        "AR01",
        "AR02"
      ],
      "note": "默认并行单模，因此为2×opticalLane；不含ELS供光纤"
    },
    {
      "id": "q-fau",
      "quantity": "signalFauAssemblies",
      "formula": "ceil(txSignalFibers / signalFauFibersPerAssembly) + ceil(rxSignalFibers / signalFauFibersPerAssembly)",
      "kind": "physical_assembly",
      "sourceIds": [
        "AR11"
      ],
      "note": "默认Tx/Rx分开且8芯/总成；16光lane时4组，8光lane时2组；若换16芯总成则数量可能不变，但使用纤芯数会变"
    },
    {
      "id": "q-cw",
      "quantity": "activeCwPaths",
      "formula": "ceil(opticalTxLanes / txLanesPerCwPath)",
      "kind": "functional_channel",
      "sourceIds": [
        "AR01",
        "AR02"
      ],
      "note": "默认1路供4Tx，6.4T×200G的8路有Ciena图示依据；其他速率按该比率缩放仍为假设"
    },
    {
      "id": "q-els-physical",
      "quantity": "elsModulesPhysical",
      "formula": "ceil(activeCwPaths / cwPathsPerElsModule)",
      "kind": "physical_assembly",
      "sourceIds": [
        "AR02"
      ],
      "note": "仅外置光源模式显示；不足8路也需完整一盒，独占采购按完整盒计"
    },
    {
      "id": "q-els-allocated",
      "quantity": "elsModuleAllocatedEquivalent",
      "formula": "activeCwPaths / cwPathsPerElsModule",
      "kind": "allocated_share",
      "sourceIds": [
        "AR02"
      ],
      "note": "仅共享供光模式可用；3.2T的0.5盒是共享资源折算，不是物理半盒；未用通道能否复用须由实际系统决定"
    },
    {
      "id": "q-isolator",
      "quantity": "isolators",
      "formula": "activeCwPaths * isolatorsPerCwPath",
      "kind": "physical_assembly",

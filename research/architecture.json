{
  "schemaVersion": "1.0.0",
  "dataset": "npo-architecture",
  "asOf": "2026-10-08",
  "scope": "单个3.2T或6.4T NPO模块及分摊供光链路。交换ASIC仅作外部位置参照，不在组件树和BOM内",
  "schemaNotes": {
    "architectures": "前端可选研究模型，每个对象含通道定义、自动电侧配置、默认集成参数及证据状态。不是厂商准确拆机BOM",
    "sourceIds": "关联sources.id；supports表示确切支持范围，不代表该来源支持同一对象中的全部模型假设",
    "status": "product=已发布产品；sampling=送样；demonstration=演示；roadmap=路线；scenario=组合研究情景；reference=相邻技术参考",
    "quantityKind": "functional_channel=功能通道数量；physical_assembly=物理采购总成数量；allocated_share=分摊数量；integrated_feature=已集成于父件的结构数量",
    "costRule": "group与integrated_feature禁止与父件采购成本重复求和；只累计选择后的独立采购层。缺乏可支持的拆分价格时，子件价格应为null",
    "date": "date为原资料日期，只有版本月份时保留YYYY-MM；accessed为本轮核验日，二者不得混用"
  },
  "definitions": [
    {
      "id": "capacity",
      "term": "3.2T/6.4T",
      "meaning": "按一个方向的名义带宽定义。全双工有同速Tx和Rx，不能把1.6T Tx＋1.6T Rx改名为3.2T",
      "sourceIds": [
        "AR02"
      ]
    },
    {
      "id": "opticalLane",
      "term": "光lane",
      "meaning": "独立调制的数据通道。本模型默认并行单模、一条波长占用一条Tx或Rx纤芯；如果引入WDM，lane数与光纤根数需分开计算",
      "sourceIds": [
        "AR01",
        "AR02"
      ]
    },
    {
      "id": "electricalLane",
      "term": "电lane",
      "meaning": "主机与光引擎之间的高速差分电通道。每方向单独计数。名义200G与器件212/224Gb/s级规格不可当作不同总带宽相加",
      "sourceIds": [
        "AR01",
        "AR02",
        "AR07"
      ]
    },
    {
      "id": "port",
      "term": "端口",
      "meaning": "多个光lane可以组成一个协议端口。8×400GBASE-DR4表示8个400G端口，合计32条100G级光lane；不表示8条400G光lane",
      "sourceIds": [
        "AR01"
      ]
    },
    {
      "id": "npo",
      "term": "NPO",
      "meaning": "本网页约定光引擎为ASIC封装外、邻近ASIC的独立模块。主机ASIC为环境参照，不属于NPO模块BOM。光引擎内部PIC与EIC的集成仍属于NPO内部封装",
      "sourceIds": [
        "AR04",
        "AR12"
      ]
    },
    {
      "id": "els",
      "term": "ELS/ELSFP",
      "meaning": "ELS是供光功能，ELSFP是一种外置可插拔光源形态。CW供光路数不必等于数据lane数，一路激光可通过分光供多个调制器",
      "sourceIds": [
        "AR01",
        "AR02"
      ]
    },
    {
      "id": "packageVsChannel",
      "term": "芯片颗数与通道数",
      "meaning": "Driver/TIA可多通道集成于一颗裸片或同一EIC。一条lane需要一个功能通道，不一定需要一颗独立芯片",
      "sourceIds": [
        "AR05",
        "AR06"
      ]
    },
    {
      "id": "fiberVsFau",
      "term": "光纤数与FAU总成数",
      "meaning": "FAU容纳多根光纤。Tx/Rx是否合并在同一FAU、供光纤是否另配FAU、PIC版图和耦合方式都会影响总成数量",
      "sourceIds": [
        "AR02",
        "AR11"
      ]
    }
  ],
